{
  "schema": 1,
  "id": "native:senfun",
  "name": "森之屋动漫 · Ruri",
  "version": "1",
  "baseUrl": "https://senfun.in/",
  "allowedOrigins": [
    "https://senfun.in"
  ],
  "search": {
    "path": "/search.html",
    "method": "GET",
    "parameters": {
      "wd": "{query}"
    },
    "root": ".module-card-items",
    "items": ".module-card-item-title a",
    "title": {
      "selector": "",
      "kind": "text"
    },
    "reference": {
      "selector": "",
      "kind": "attribute",
      "attribute": "href"
    }
  },
  "catalog": {
    "root": "body",
    "roads": ".module-play-list-content",
    "episodes": "a.module-play-list-link",
    "title": {
      "selector": "",
      "kind": "text"
    },
    "reference": {
      "selector": "",
      "kind": "attribute",
      "attribute": "href"
    }
  },
  "resolver": "browser",
  "blockAds": false
}
